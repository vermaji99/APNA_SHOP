# APNA-MENS - Git Ignore

# Dependencies
/vendor/
/node_modules/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Uploads (keep structure, ignore files)
public/uploads/*
!public/uploads/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Cache
cache/
tmp/

# Database backups
*.sql.gz
*.sql.bak




